    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Costs Accrued by each Facility&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logistics_Analysis' name='federated.1qlfjch0y8hhwv153bdbg1yt8v4f' />
          </datasources>
          <datasource-dependencies datasource='federated.1qlfjch0y8hhwv153bdbg1yt8v4f'>
            <column caption='SUM Costs' datatype='real' name='[Calculation_1545950459695104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([cargo_damage_cost]) + ZN([vehicle_damage_cost])' />
            </column>
            <column caption='Cargo Damage Cost' datatype='real' name='[cargo_damage_cost]' role='measure' type='quantitative' />
            <column caption='Facility Id' datatype='string' name='[facility_id]' role='dimension' type='nominal' />
            <column-instance column='[facility_id]' derivation='None' name='[none:facility_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1545950459695104]' derivation='Sum' name='[sum:Calculation_1545950459695104:qk]' pivot='key' type='quantitative' />
            <column caption='Vehicle Damage Cost' datatype='real' name='[vehicle_damage_cost]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qlfjch0y8hhwv153bdbg1yt8v4f].[none:facility_id:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:facility_id:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:facility_id:nk]' member='%null%' />
                <groupfilter function='member' level='[none:facility_id:nk]' member='&quot;FAC00017&quot;' />
                <groupfilter function='member' level='[none:facility_id:nk]' member='&quot;FAC00036&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1qlfjch0y8hhwv153bdbg1yt8v4f].[none:facility_id:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
